rules_version = '2';
// 6.3 DisGret accounts (spec 016, ADR-0013): each signed-in user reads and writes only their own
// records under users/{uid}; everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
